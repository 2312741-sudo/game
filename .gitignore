# Builds / crash reports
*.apk
*.aab
*.unitypackage
crashlytics-build.properties
sysinfo.txt

# Blender autosaves
*.blend1
*.blend2

# QA scratch output (reports in QA/Reports are committed)
/QA/Output/
/Automation/__pycache__/
