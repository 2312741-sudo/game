    _en: Already Ready
    _vi: "\u0110\xE3 ho\xE0n t\u1EA5t"
  - _key: ready.no_ready_order
    _en: No ready order
    _vi: "Ch\u01B0a c\xF3 \u0111\u01A1n ho\xE0n t\u1EA5t"
  - _key: interaction.paused
    _en: Paused
    _vi: "\u0110ang t\u1EA1m d\u1EEBng"
  - _key: interaction.stall_role_required
    _en: Stall role required
    _vi: "C\u1EA7n vai tr\xF2 qu\u1EA7y"
  - _key: interaction.lobby_role_required
    _en: Lobby role required
    _vi: "C\u1EA7n vai tr\xF2 Lobby"
  - _key: interaction.held_continuous_not_supported
    _en: Unsupported held action
    _vi: "Kh\xF4ng h\u1ED7 tr\u1EE3 thao t\xE1c n\xE0y"
  - _key: interaction.item_not_held
    _en: Hold the item first
    _vi: "C\u1EA7n c\u1EA7m v\u1EADt ph\u1EA9m"
