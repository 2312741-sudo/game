  _entries:
  - _key: preview.controls
    _en: "WASD: move \xB7 E/left mouse: station \xB7 F/right mouse: held item \xB7 Esc: pause"
    _vi: "WASD: di chuy\u1EC3n \xB7 E/chu\u1ED9t tr\xE1i: qu\u1EA7y \xB7 F/chu\u1ED9t ph\u1EA3i: v\u1EADt \u0111ang c\u1EA7m \xB7 Esc: t\u1EA1m d\u1EEBng"
  - _key: preview.key
    _en: '[E / LMB]'
    _vi: "[E / chu\u1ED9t tr\xE1i]"
  - _key: preview.held_key
    _en: '[F / RMB]'
    _vi: "[F / chu\u1ED9t ph\u1EA3i]"
  - _key: order.entry.title
    _en: Customer request
    _vi: "Kh\xE1ch g\u1ECDi m\xF3n"
  - _key: order.entry.enter
    _en: Enter order
    _vi: "Nh\u1EADp \u0111\u01A1n"
  - _key: order.entry.send
    _en: Send to stall
    _vi: "G\u1EEDi t\u1EDBi qu\u1EA7y"
  - _key: item.drink.slice
    _en: Drink (menu name pending)
