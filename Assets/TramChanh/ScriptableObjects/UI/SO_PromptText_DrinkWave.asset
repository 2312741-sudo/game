    _en: Add coconut jelly
    _vi: "Th\xEAm th\u1EA1ch d\u1EEBa"
  - _key: drink.add_lemon
    _en: Add lemon jelly
    _vi: "Th\xEAm th\u1EA1ch chanh"
  - _key: drink.add_ice
    _en: Scoop ice
    _vi: "Th\xEAm \u0111\xE1"
