    _en: Take order
    _vi: "Nh\u1EADn y\xEAu c\u1EA7u c\u1EE7a kh\xE1ch"
  - _key: order.point.continue
    _en: Continue order
    _vi: "Ti\u1EBFp t\u1EE5c nh\u1EADp \u0111\u01A1n"
  - _key: order.entry.close
    _en: Close
    _vi: "\u0110\xF3ng"
  - _key: drink.rack.take_bag
    _en: Take pre-portioned tea bag
    _vi: "L\u1EA5y t\xFAi tr\xE0 chia s\u1EB5n"
  - _key: drink.bag.open
    _en: Open tea bag
    _vi: "M\u1EDF t\xFAi tr\xE0"
