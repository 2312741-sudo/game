    _en: Add coconut jelly first
    _vi: "Th\xEAm th\u1EA1ch d\u1EEBa tr\u01B0\u1EDBc"
  - _key: drink.need_lemon_first
    _en: Add lemon jelly first
    _vi: "Th\xEAm th\u1EA1ch chanh tr\u01B0\u1EDBc"
  - _key: drink.need_ice_first
    _en: Add ice first
    _vi: "Th\xEAm \u0111\xE1 tr\u01B0\u1EDBc"
  - _key: drink.need_shake_first
    _en: Shake first
    _vi: "L\u1EAFc tr\u01B0\u1EDBc"
