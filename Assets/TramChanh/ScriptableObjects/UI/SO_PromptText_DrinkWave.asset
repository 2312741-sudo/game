    _en: Hold to shake
    _vi: "Gi\u1EEF \u0111\u1EC3 l\u1EAFc"
  - _key: drink.wipe
    _en: Hold to wipe
    _vi: "Gi\u1EEF \u0111\u1EC3 lau"
