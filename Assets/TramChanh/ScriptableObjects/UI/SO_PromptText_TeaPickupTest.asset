  m_Name: SO_PromptText_TeaPickupTest
  m_EditorClassIdentifier: TramChanh.UI::TramChanh.UI.Localization.PromptLocalizationTable
  _entries:
  - _key: preview.controls
    _en: 'WASD: move   Mouse: look   E / click: take bag   Esc: pause   Pickup test only'
    _vi: "WASD: di chuy\u1EC3n   Chu\u1ED9t: nh\xECn   E / nh\u1EA5p: l\u1EA5y t\xFAi tr\xE0   Esc: t\u1EA1m d\u1EEBng   C\u1EA3nh th\u1EED l\u1EA5y t\xFAi"
  - _key: preview.key
    _en: '[E / LMB]'
    _vi: "[E / chu\u1ED9t tr\xE1i]"
  - _key: preview.tea_rack.inspect
    _en: Inspect tea rack placeholder
    _vi: "Ki\u1EC3m tra gi\xE1 tr\xE0 t\u1EA1m"
  - _key: preview.tea_rack.reset
    _en: "Tea rack inspected \u2014 reset highlight"
    _vi: "\u0110\xE3 ki\u1EC3m tra gi\xE1 tr\xE0 \u2014 b\u1ECF \u0111\xE1nh d\u1EA5u"
  - _key: preview.grill.inspect
    _en: Inspect grill placeholder
    _vi: "Ki\u1EC3m tra b\u1EBFp n\u01B0\u1EDBng t\u1EA1m"
  - _key: preview.grill.reset
    _en: "Grill inspected \u2014 reset highlight"
    _vi: "\u0110\xE3 ki\u1EC3m tra b\u1EBFp \u2014 b\u1ECF \u0111\xE1nh d\u1EA5u"
  - _key: preview.cube.inspect
    _en: Inspect test cube
    _vi: "Ki\u1EC3m tra kh\u1ED1i th\u1EED nghi\u1EC7m"
  - _key: preview.cube.reset
    _en: "Cube inspected \u2014 reset highlight"
    _vi: "\u0110\xE3 ki\u1EC3m tra kh\u1ED1i \u2014 b\u1ECF \u0111\xE1nh d\u1EA5u"
  - _key: preview.blocked
    _en: Inspection temporarily blocked
    _vi: "T\u1EA1m th\u1EDDi kh\xF4ng th\u1EC3 ki\u1EC3m tra"
  - _key: drink.rack.take_bag
    _en: Take pre-portioned tea bag
    _vi: "L\u1EA5y t\xFAi tr\xE0 chia s\u1EB5n"
  - _key: hands.full
    _en: "Hands full \u2014 already holding an item"
    _vi: "\u0110ang c\u1EA7m v\u1EADt ph\u1EA9m"
  - _key: drink.rack.empty
    _en: Tea rack is empty
    _vi: "Gi\xE1 tr\xE0 \u0111\xE3 h\u1EBFt t\xFAi"
  - _key: stall.no_ticket.drink
    _en: A drink ticket from Lobby is required
    _vi: "C\u1EA7n phi\u1EBFu n\u01B0\u1EDBc t\u1EEB Lobby"
  - _key: interaction.paused
    _en: Game paused
    _vi: "\u0110ang t\u1EA1m d\u1EEBng"
  - _key: interaction.stall_role_required
    _en: Stall role required
    _vi: "C\u1EA7n vai tr\xF2 qu\u1EA7y"
  - _key: drink.rack.not_configured
    _en: Tea rack setup is missing
    _vi: "Thi\u1EBFu thi\u1EBFt l\u1EADp gi\xE1 tr\xE0"
  - _key: preview.held_key
    _en: "[F / RMB]"
    _vi: "[F / chuột phải]"
